# Production / Docker sample. Replace SECRET_KEY, DB_PASSWORD and RESEND_API_KEY.
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=app.artexperts.net,localhost,127.0.0.1
DB_ENGINE=postgresql
DB_NAME=artexperts
DB_USER=artexperts
DB_PASSWORD=artexperts
# Direct host execution uses localhost. Compose overrides this to db.
DB_HOST=localhost
DB_PORT=5432
SITE_URL=https://artexperts.net
BACKEND_URL=https://app.artexperts.net
API_URL=https://app.artexperts.net/api/v1
NEXT_PUBLIC_SITE_URL=https://artexperts.net
NEXT_PUBLIC_BACKEND_URL=https://app.artexperts.net
NEXT_PUBLIC_API_URL=https://app.artexperts.net/api/v1
CORS_ALLOWED_ORIGINS=https://artexperts.net
CSRF_TRUSTED_ORIGINS=https://artexperts.net,https://app.artexperts.net
SESSION_COOKIE_DOMAIN=.artexperts.net
CSRF_COOKIE_DOMAIN=.artexperts.net
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=False
RESEND_API_KEY=fake_pass
RESEND_FROM_EMAIL=info@artexperts.net
CERTBOT_EMAIL=info@artexperts.net
GUNICORN_WORKERS=3
