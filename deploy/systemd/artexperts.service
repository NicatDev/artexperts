[Unit]
Description=Art Experts Docker Compose platform
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/artexperts
ExecStart=/usr/bin/docker compose up --wait --wait-timeout 180
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=240

[Install]
WantedBy=multi-user.target
